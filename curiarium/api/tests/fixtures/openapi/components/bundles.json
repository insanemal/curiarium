    "type": "object"
  },
  "BundleArrangePlanOut": {
    "description": "The arrangement preview the apply echoes back by ``plan_id``.\n\n``text`` is rendered from ``moves``, never beside it, so every sentence the\noperator reads is backed by a record in the list. ``adoptions`` is the other\nhalf of a plan's effect: the memberships it adds, which a zero-move plan is\nmade of entirely.",
    "properties": {
      "adoptions": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/BundleArrangeAdoptionsOut"
          },
          {
            "type": "null"
