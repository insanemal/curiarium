  "BundleMatchOut": {
    "description": "One shape a listing satisfies: the rule that offered it and its counts.\n\n``matches[0]`` on a row is the recommended shape and equals the row's own\n`detector`/`confidence`/`metadata_shape`; the rest are the alternatives. The\nmanual entry (shape `manual`) is always present and last unless the row itself\nrecommends it, and `note` carries the refusal word a manual offer was built\nfrom.\n\nA match the server cannot enact yet is still offered, because withholding it\nwould hide the reading that disagrees with the detector - an honest reading is\nworth more than a short list. ``creatable=False`` plus a ``note`` saying why\nis the contract: the client must not let the operator pick such a shape, and\nthe create path refuses it with ``needs-arrange``. ``creatable`` means \"this\nshape is enactable once the row is ready; the row's own ``status`` still gates\nthe create\".",
    "properties": {
      "confidence": {
        "title": "Confidence",
        "type": "string"
      },
      "creatable": {
        "default": true,
        "title": "Creatable",
        "type": "boolean"
      },
      "groups": {
        "default": [],
        "items": {
          "$ref": "#/components/schemas/BundleGroupOut"
        },
        "title": "Groups",
        "type": "array"
      },
      "image_count": {
        "default": 0,
        "title": "Image Count",
        "type": "integer"
      },
      "model_count": {
        "default": 0,
        "title": "Model Count",
        "type": "integer"
      },
      "note": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Note"
      },
      "other_count": {
        "default": 0,
        "title": "Other Count",
        "type": "integer"
      },
      "rule": {
        "title": "Rule",
        "type": "string"
      },
      "shape": {
        "title": "Shape",
        "type": "string"
      },
      "text_count": {
        "default": 0,
        "title": "Text Count",
        "type": "integer"
      }
    },
    "required": [
      "shape",
      "rule",
      "confidence"
    ],
    "title": "BundleMatchOut",
    "type": "object"
  },
