        "default": 0,
        "title": "Other Count",
        "type": "integer"
      },
      "rule": {
        "title": "Rule",
        "type": "string"
      },
      "shape": {
        "title": "Shape",
        "type": "string"
      },
      "text_count": {
        "default": 0,
        "title": "Text Count",
        "type": "integer"
      }
    },
    "required": [
