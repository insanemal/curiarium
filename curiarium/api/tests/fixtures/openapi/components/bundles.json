      },
      "unseeable": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Unseeable",
        "type": "array"
      }
    },
    "required": [
      "arrange_id",
      "key",
      "undone"
    ],
    "title": "BundleArrangeUndoOut",
    "type": "object"
  },
