    "type": "object"
  },
  "BundleArrangeRefusalOut": {
    "description": "One reason the arrangement cannot be applied, with its own status.\n\n``plan`` returns these instead of raising: a 200 with a non-empty list is the\nhonest preview, and ``apply`` raises the first one.",
