  "BundleArrangeAdoptionsOut": {
    "description": "The memberships a plan would ADD: the whole of a zero-move plan.\n\n``total`` is every registered file the targets do not hold, ``by_role`` splits\nit by the scan's own classifier, and ``groups`` partitions it by the engine's\ngroups with an explicit ``(root files)`` bucket, so\n``sum(group.files for group in groups) == total`` always holds - a count that\ncan silently shrink is the bug this field exists to end.",
    "properties": {
      "by_role": {
        "additionalProperties": {
          "type": "integer"
        },
        "default": {},
        "title": "By Role",
        "type": "object"
      },
      "groups": {
        "default": [],
        "items": {
          "$ref": "#/components/schemas/BundleArrangeGroupOut"
        },
        "title": "Groups",
        "type": "array"
      },
      "sample_names": {
        "default": [],
        "items": {
          "type": "string"
        },
        "title": "Sample Names",
        "type": "array"
      },
      "target": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/BundleArrangeTargetOut"
          },
          {
            "type": "null"
          }
        ]
      },
      "total": {
        "default": 0,
        "title": "Total",
        "type": "integer"
      },
      "unregistered": {
        "default": 0,
        "title": "Unregistered",
        "type": "integer"
      }
    },
    "title": "BundleArrangeAdoptionsOut",
    "type": "object"
  },
