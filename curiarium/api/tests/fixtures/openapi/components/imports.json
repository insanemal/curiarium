  "ZipEntryOut": {
    "description": "One zip member as an entries listing reports it.\n\n`junk` is the server's verdict (`entry_policy.is_junk_entry`) that the member\nis OS metadata - `__MACOSX/`, `.DS_Store`, `Thumbs.db`, an AppleDouble `._*` -\nand both extract workflows refuse it: `import-zip` reports it in `failed`, and\n`extract` names it in the plan's `excluded`. The server decides it; the browser\nonly uses it to choose the modal's default ticks.",
    "properties": {
      "junk": {
        "title": "Junk",
        "type": "boolean"
