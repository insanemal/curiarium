  "OperationUndoOut": {
    "description": "The result of undoing a finished operation, shaped by its workflow.\n\nA `create-project` undo answers the project it deleted and leaves the two\nworkflow-specific keys null; a `split-and-create` undo answers ``moves`` (how\nmany landed moves were folded back) and ``projects_removed`` (the projects it\ncreated and then deleted), and leaves the project pair null. Optional on both\nsides so neither body gains a fabricated zero.",
    "properties": {
      "moves": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Moves"
      },
      "operation_id": {
        "title": "Operation Id",
        "type": "string"
      },
      "project_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Project Id"
      },
      "project_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Project Name"
      },
      "projects_removed": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "title": "Projects Removed"
      },
      "undone": {
        "title": "Undone",
        "type": "boolean"
      }
    },
    "required": [
      "operation_id",
      "undone"
    ],
    "title": "OperationUndoOut",
    "type": "object"
  }
}
