  "OperationProjectOut": {
    "description": "One project a plan would create: its name, the path it lives at, its size.\n\n``members`` is the count of files the plan would attach, after every exclusion,\nso it is the number the create step will actually write - not a folder's file\ncount.",
    "properties": {
      "members": {
        "title": "Members",
        "type": "integer"
      },
      "name": {
