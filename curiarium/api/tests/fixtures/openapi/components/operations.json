            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Error"
      },
      "finished_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Finished At"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "started_at": {
        "anyOf": [
