  "OperationMoveOut": {
    "description": "One move a plan would make, both ends storage-root-relative.\n\n``source``/``target`` rather than ``from``/``to`` because ``from`` is a Python\nkeyword; unlike the deleted arrange model this does not alias, because the\noperations review is the only place the pair is served and the wire reads\nbetter naming both ends symmetrically.\n\n``kind`` is what the path IS (``file``/``dir``); ``action`` is why the move\nexists (``hoist`` for a split). The client renders the line from these records\nand never from prose.",
    "properties": {
      "action": {
        "title": "Action",
        "type": "string"
      },
      "kind": {
        "title": "Kind",
        "type": "string"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "target": {
        "title": "Target",
        "type": "string"
      }
    },
    "required": [
      "source",
      "target",
      "kind",
      "action"
    ],
    "title": "OperationMoveOut",
    "type": "object"
  },
  "OperationOut": {
    "description": "One operation and its steps, newest state as stored.",
