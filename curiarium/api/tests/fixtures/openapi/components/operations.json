            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Started At"
      },
      "status": {
        "title": "Status",
        "type": "string"
      },
      "steps": {
        "default": [],
        "items": {
          "$ref": "#/components/schemas/OperationStepOut"
        },
        "title": "Steps",
        "type": "array"
      },
      "submitted_by": {
        "title": "Submitted By",
        "type": "string"
      },
      "superseded_by": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Superseded By"
      },
      "target": {
        "title": "Target",
        "type": "string"
      },
      "undo_state": {
        "title": "Undo State",
        "type": "string"
      },
      "workflow": {
        "title": "Workflow",
        "type": "string"
      }
    },
    "required": [
      "id",
      "workflow",
      "target",
      "status",
      "submitted_by",
      "created_at",
      "undo_state"
    ],
    "title": "OperationOut",
    "type": "object"
  },
  "OperationPlanOut": {
    "description": "A computed plan: the opaque id to submit, plus the steps and review.",
