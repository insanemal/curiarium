    "type": "object"
  },
  "OperationPlanRequest": {
    "additionalProperties": false,
    "description": "What to do and where.\n\n`extra=\"forbid\"` is the proof a client cannot smuggle a step list in alongside\n`workflow` and `target`.",
    "properties": {
      "params": {
        "additionalProperties": true,
        "default": {},
